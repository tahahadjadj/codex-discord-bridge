DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_GUILD_ID=replace-with-your-server-id

# Optional hardening. Comma-separated Discord user IDs allowed to control Codex.
OWNER_DISCORD_USER_IDS=

# Optional completion pings for locally discovered sessions. Discord messages
# ping the user who last interacted with that mirrored session automatically.
DISCORD_NOTIFY_USER_IDS=

# Optional Codex defaults.
CODEX_COMMAND=codex
CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=xhigh
CODEX_CWD=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request

# Optional Discord layout.
DISCORD_CATEGORY_NAME=Codex Sessions
DISCORD_CONTROL_CHANNEL_NAME=codex-control
CODEX_DISCOVER_ACTIVE_SESSIONS=true
CODEX_ACTIVE_SESSION_MAX_AGE_HOURS=6
CODEX_SESSION_SYNC_INTERVAL_MS=30000
CODEX_SESSION_SYNC_LIMIT=25
DISCORD_MAX_MIRRORED_SESSION_CHANNELS=75
DISCORD_MAX_GUILD_CHANNELS=450
DISCORD_CHANNEL_PRUNE_MIN_AGE_HOURS=24
CODEX_REQUEST_TIMEOUT_MS=45000
DISCORD_STREAM_FLUSH_INTERVAL_MS=1500
CODEX_INTERRUPTED_TURN_GRACE_MS=120000
CODEX_THREAD_SYNC_QUIET_MS=60000
CODEX_THREAD_SYNC_BACKOFF_MS=300000
DISCORD_COMPLETION_PING_QUIET_MS=10000
DISCORD_CHANNEL_REORDER_DEBOUNCE_MS=2000

# Local log retention. Raw app-server stderr may contain large diagnostics and
# is disabled by default. Enable it only for short, supervised debugging.
CODEX_LOG_APP_SERVER_STDERR=false
BRIDGE_LOG_DIR=
BRIDGE_LOG_MAX_BYTES=10485760
BRIDGE_LOG_CHECK_INTERVAL_MS=3600000
DISCORD_ATTACHMENT_DIR=
DISCORD_IMAGE_ATTACHMENT_MAX_COUNT=4
DISCORD_IMAGE_ATTACHMENT_MAX_BYTES=10485760

# Optional for Codex notify integration. If omitted, the notify script uses
# DISCORD_CONTROL_CHANNEL_NAME in DISCORD_GUILD_ID.
DISCORD_NOTIFY_CHANNEL_ID=
